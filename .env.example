# === Public URL of this site ===
# Used to build Stripe success/cancel redirect URLs.
# Local dev: http://localhost:3000
# Production: https://sendprop.com
PUBLIC_BASE_URL=

# === Stripe ===
# From https://dashboard.stripe.com/apikeys (test keys are fine to start)
STRIPE_SECRET_KEY=
# From https://dashboard.stripe.com/webhooks after you create the endpoint
STRIPE_WEBHOOK_SECRET=

# === Resend (notification emails) ===
# From https://resend.com/api-keys
RESEND_API_KEY=
# Where order notifications are sent (your inbox)
NOTIFICATION_EMAIL=
# From-address for the notification (must be on a verified Resend domain)
NOTIFICATION_FROM=Sendprop <notify@sendprop.com>
